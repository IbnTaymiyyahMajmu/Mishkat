{"v":1,"work":"mujtaba-mushkil-iraab","surah":106,"passages":[[1,1,"الجار «لإيلاف» متعلق بـ «يعبدوا» في الآية (3) ."],[2,2,"«إيلافهم» : بدل من «إيلاف» ، «رحلة» : مفعول به للمصدر «إيلافهم» ."],[3,3,"الفاء زائدة، واللام للأمر، والفعل مجزوم بحذف النون، «هذا» : مضاف إليه."],[4,4,"«الذي» : نعت لـ {رَبَّ} ."]]}