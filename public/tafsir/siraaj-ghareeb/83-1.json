{"v":1,"work":"siraaj-ghareeb","surah":83,"passages":[[1,1,"﴿وَيْلٌ﴾: عَذابٌ شَدِيدٌ.\n﴿لِّلْمُطَفِّفِينَ﴾: الَّذِينَ يَبْخَسُونَ المِكْيالَ، والمِيزانَ."],[3,3,"﴿يُخْسِرُونَ﴾: يَنْقُصُونَ فيِ المِكْيالِ، والمِيزانَ."],[4,4,"﴿يَظُنُّ﴾: يَعتَقِدُ."],[7,7,"﴿كِتَابَ الفُجَّارِ﴾: كِتابَ أعْمالِهِمْ، أوْ مَصِيرَهُمِ.\n﴿سِجِّينٍ﴾: سِجْنٍ، وضِيقٍ."],[9,9,"﴿مَّرْقُومٌ﴾: مَكْتُوبٌ كالرَّقْمِ فِي الثَّوْبِ لا يُمْحى."],[12,12,"﴿مُعْتَدٍ﴾: ظالِمِ مُتَجاوِزٍ لِلْحَدِّ.\n﴿أَثِيمٍ﴾: كَثِيرِ الإثْمِ."],[13,13,"﴿أَسَاطِيرُ﴾: أباطِيلُ"],[14,14,"﴿رَانَ﴾: غَطّى."],[15,15,"﴿لَّمَحْجُوبُونَ﴾: مَحْرُومُونَ مِن رُؤْيَةِ رَبِّهِمْ."],[16,16,"﴿لَصَالُوا الْجَحِيمِ﴾: لَداخِلُو النّارِ يُقاسُونَ حَرَّها."],[18,18,"﴿لَفِي عِلِّيِّينَ﴾: لَفِي مَرْتَبَةٍ، ومَكانٍ عالٍ."],[23,23,"﴿الْأَرَائِكِ﴾: الأَسِرَّةِ المُزَيَّنَةِ بِالسُّتُورِ، والثِّيابِ."],[24,24,"﴿نَضْرَةَ﴾: بَهْجَةَ."],[25,25,"﴿رَّحِيقٍ﴾: خَمْرٍ صافِيَةٍ."],[26,26,"﴿خِتَامُهُ مِسْكٌ﴾: آخِرُهُ رائِحَةُ المِسْكِ."],[27,27,"﴿وَمِزَاجُهُ﴾: خَلْطُهُ.\n﴿تَسْنِيمٍ﴾: عَيْنٍ فيِ أعْلى الجَنَّةِ."],[28,28,"﴿يَشْرَبُ بِهَا﴾: يَشْرَبُونَ مُتَلَذِّذِينَ بِها."],[30,30,"﴿يَتَغَامَزُونَ﴾: يَغْمِزُ بَعْضُهُمْ بَعْضًا بِأَعْيُنِهِمُ اسْتِهْزاءً."],[31,31,"﴿انقَلَبُوا﴾: رَجَعُوا.\n﴿فَكِهِينَ﴾: مُتَلَذِّذِينَ بِسُخْرِيَتِهِمْ مِنَ المَؤْمِنِينَ."],[33,33,"﴿حَافِظِينَ﴾: رُقَباءَ يُحْصُونَ أعْمالَهُمْ."],[36,36,"﴿ثُوِّبَ﴾: جُوزِيَ."]]}