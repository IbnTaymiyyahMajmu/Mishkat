{"v":1,"work":"siraaj-ghareeb","surah":26,"passages":[[3,3,"﴿بَاخِعٌ﴾: مُهْلِكٌ."],[5,5,"﴿مُحْدَثٍ﴾: حَدِيثِ النُّزُولِ."],[7,7,"﴿زَوْجٍ كَرِيمٍ﴾: نَوْعٍ حَسَنٍ نافِعٍ."],[20,20,"﴿الضَّالِّينَ﴾: الجاهِلِينَ، وذَلِكَ قَبْلَ أنْ يُوحى إليَّ."],[21,21,"﴿حُكْمًا﴾: النُّبُوَّةَ."],[22,22,"﴿عَبَّدتَّ﴾: جَعَلْتَهُمْ عَبِيدًا."],[33,33,"﴿وَنَزَعَ يَدَهُ﴾: أخْرَجَها مِن جَيْبِهِ."],[36,36,"﴿أَرْجِهِ﴾: أخِّرْهُ.\n﴿حَاشِرِينَ﴾: جُنُودًا يَجْمَعُونَ السَّحَرَةَ."],[44,44,"﴿بِعِزَّةِ فِرْعَوْنَ﴾: أقْسَمُوا بِعِزَّتِهِ، وقُوَّتِهِ."],[45,45,"﴿تَلْقَفُ﴾: تَبْتَلِعُ بِسُرْعَةٍ.\n﴿مَا يَافِكُونَ﴾: ما يَفْعَلُونَهُ مِنَ الكَذِبِ والتَّزْوِيرِ."],[49,49,"﴿مِّنْ خِلَافٍ﴾: بِقَطْعِ اليَدِ اليُمْنى والرِّجْلِ اليُسْرى، أوْ عَكْسَ ذَلِكَ."],[50,50,"﴿لَا ضَيْرَ﴾: لا ضَرَرَ.\n﴿مُنقَلِبُونَ﴾: راجِعُونَ."],[53,53,"﴿حَاشِرِينَ﴾: جامِعِينَ لِلْجَيْشِ مِنَ المَدائِنِ."],[54,54,"﴿لَشِرْذِمَةٌ﴾: لَطائِفَةٌ حَقِيرَةٌ."],[58,58,"﴿وَكُنُوزٍ﴾: خَزائِنِ الأَمْوالِ.\n﴿وَمَقَامٍ كَرِيمٍ﴾: مَنازِلَ حِسانٍ."],[60,60,"﴿مُّشْرِقِينَ﴾: وقْتَ شُرُوقِ الشَّمْسِ."],[61,61,"﴿تَرَاءَى الْجَمْعَانِ﴾: رَأى كُلُّ فَرِيقٍ الآخَرَ."],[63,63,"﴿فِرْقٍ﴾: قِطْعَةٍ مِنَ البَحْرِ.\n﴿كَالطَّوْدِ﴾: كالجَبَلِ."],[64,64,"﴿وَأَزْلَفْنَا ثَمَّ الْآخَرِينَ﴾: قَرَّبْنا هُناكَ، فِرَعْوَنَ، وقَوْمَهُ."],[71,71,"﴿عَاكِفِينَ﴾: مُقِيمِينَ عَلى عِبادَتِها."],[75,75,"﴿أَفَرَأَيْتُم﴾: أبْصَرْتُمْ بِتَدَبُّرٍ."],[83,83,"﴿حُكْمًا﴾: عِلْمًا وفَهْمًا."],[84,84,"﴿لِسَانَ صِدْقٍ﴾: ثَناءً حَسَنًا.\n﴿الْآخِرِينَ﴾: مَن ياتُونَ بَعْدِي إلى يَوْمِ القِيامَةِ."],[89,89,"﴿سَلِيمٍ﴾: سالِمٍ مِنَ الشِّرْكِ والنِّفاقِ والضَّغِينَةِ."],[90,90,"﴿وَأُزْلِفَتِ﴾: قُرِّبَتْ."],[91,91,"﴿وَبُرِّزَتِ﴾: أُظْهِرَتْ."],[94,94,"﴿فَكُبْكِبُوا﴾: فَجُمِعُوا، وأُلْقُوا."],[101,101,"﴿حَمِيمٍ﴾: مُشْفِقٍ يَهْتَمُّ بِأَمْرِنا."],[102,102,"﴿كَرَّةً﴾: رَجْعَةً إلى الدُّنْيا."],[111,111,"﴿الْأَرْذَلُونَ﴾: السَّفَلَةُ مِنَ النّاسِ."],[116,116,"﴿الْمَرْجُومِينَ﴾: المَقْتُولِينَ رَمْيًا بِالحِجارَةِ."],[118,118,"﴿فَافْتَحْ﴾: احْكُمْ."],[119,119,"﴿الْمَشْحُونِ﴾: المَمْلُوءِ بِالنّاسِ، والدَّوابِّ، والمَتاعِ."],[128,128,"﴿رِيعٍ﴾: مَكانٍ مُرْتَفِعٍ.\n﴿آيَةً﴾: بِناءً عالِيًا.\n﴿تَعْبَثُونَ﴾: تُشْرِفُونَ مِنهُ فَتَسْخَرُونَ مِنَ المارَّةِ."],[129,129,"﴿مَصَانِعَ﴾: قُصُورًا مَنِيعَةً وحُصُونًا مُشَيَّدَةً."],[132,132,"﴿أَمَدَّكُم﴾: أعْطاكُمْ وأَنْعَمَ عَلَيْكُمْ."],[136,136,"﴿سَوَاءٌ عَلَيْنَا﴾: يَسْتَوِي عِنْدَنا.\n﴿أَوَعَظْتَ﴾: أخَوَّفْتَ."],[137,137,"﴿خُلُقُ﴾: دِينُ، وعادَةُ."],[148,148,"﴿طَلْعُهَا هَضِيمٌ﴾: ثَمَرُها يانِعٌ لَيِّنٌ نَضِيجٌ."],[149,149,"﴿فَارِهِينَ﴾: ماهِرِينَ بِنَحْتِها أشِرِينَ بَطِرِينَ."],[151,151,"﴿الْمُسْرِفِينَ﴾: المُتَمادِينَ فيِ مَعْصِيَةِ اللهِ."],[153,153,"﴿الْمُسَحَّرِينَ﴾: المَغْلُوبِ عَلى عُقُولِهِمْ بِكَثْرَةِ السِّحْرِ."],[155,155,"﴿شِرْبُ﴾: نَصِيبٌ مِنَ الماءِ."],[157,157,"﴿فَعَقَرُوهَا﴾: نَحَرُوها."],[166,166,"﴿عَادُونَ﴾: مُتَجاوِزُونَ ما أباحَهُ اللهُ لَكُمْ مِنَ الحَلالِ إلى الحَرامِ."],[167,167,"﴿الْمُخْرَجِينَ﴾: المَطْرُودِينَ مِن بِلادِنا."],[168,168,"﴿الْقَالِينَ﴾: المُبْغِضِينَ لِعَمَلِكُمْ بُغْضًا شَدِيدًا."],[171,171,"﴿الْغَابِرِينَ﴾: الباقِينَ فيِ العَذابِ."],[173,173,"﴿فَسَاءَ﴾: قَبُحَ."],[176,176,"﴿أَصْحَابُ الْأَيْكَةِ﴾: أصْحابُ الأَرْضِ ذاتِ الشَّجَرِ المُلْتَفِّ، وهُمْ قَوْمُ شُعَيْبٍ."],[181,181,"﴿الْمُخْسِرِينَ﴾: النّاقِصِينَ لِحُقُوقِ النّاسِ."],[182,182,"﴿بِالْقِسْطَاسِ﴾: بِالمِيزانِ.\n﴿الْمُسْتَقِيمِ﴾: العَدْلِ السَّوِيِّ."],[183,183,"﴿وَلَا تَبْخَسُوا﴾: لا تَنْقُصُوا.\n﴿وَلَا تَعْثَوْا﴾: لا تُكْثِرُوا الفَسادَ."],[184,184,"﴿وَالْجِبِلَّةَ الْأَوَّلِينَ﴾: الخَلِيقَةَ والأُمَمَ الماضِينَ."],[185,185,"﴿الْمُسَحَّرِينَ﴾: مَن أصابَهُمْ سِحْرٌ شَدِيدٌ، فَذَهَبَ بِعُقُولِهِمْ."],[187,187,"﴿كِسَفًا﴾: قِطَعًا مِنَ العَذابِ."],[189,189,"﴿الظُّلَّةِ﴾: سَحابَةٍ أظَلَّتْهُمْ وجَدُوا تَحْتَها بَرْدًا، فَلمّا اجْتَمَعُوا أحْرَقَتْهُمْ بِنارِها."],[193,193,"﴿الرُّوحُ الْأَمِينُ﴾: جِبْرِيلُ عليه السلام."],[196,196,"﴿زُبُرِ الْأَوَّلِينَ﴾: كُتُبِ الأَنْبِياءِ السّابِقِينَ."],[197,197,"﴿آيَةً﴾: عَلامَةً عَلى صِحَّةِ نُبُوَّتِكَ."],[198,198,"﴿الْأَعْجَمِينَ﴾: الَّذِينَ لا يَتَكَلَّمُونَ العَرَبِيَّةَ."],[200,200,"﴿سَلَكْنَاهُ﴾: أدْخَلْنا التَّكْذِيبَ."],[202,202,"﴿بَغْتَةً﴾: فَجْأَةً."],[203,203,"﴿مُنظَرُونَ﴾: مُمْهَلُونَ مُؤَخَّرُونَ."],[205,205,"﴿أَفَرَأَيْتَ﴾: أفَعَلِمْتَ؟"],[212,212,"﴿السَّمْعِ﴾: اسْتِماعِ القُرْآنِ مِنَ السَّماءِ.\n﴿لَمَعْزُولُونَ﴾: لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ."],[215,215,"﴿وَاخْفِضْ جَنَاحَكَ﴾: ألِنْ جانِبَكَ وكَلامَكَ تَواضُعًا."],[218,218,"﴿حِينَ تَقُومُ﴾: تُصَلِّي اللَّيْلَ وحْدَكَ."],[222,222,"﴿أَفَّاكٍ﴾: كَذّابٍ.\n﴿أَثِيمٍ﴾: كَثِيرِ الآثامِ."],[223,223,"﴿يُلْقُونَ السَّمْعَ﴾: تُلْقِي الشَّياطِينُ إلى الكُهّانِ ما يَسْتَرِقُونَ مِنَ المَلَأِ الأَعْلى."],[225,225,"﴿وَادٍ﴾: فَنٍّ مِن فُنُونِ الباطِلِ، والكَذِبِ.\n﴿يَهِيمُونَ﴾: يَخُوضُونَ."],[227,227,"﴿مُنقَلَبٍ﴾: مَرْجِعٍ."]]}